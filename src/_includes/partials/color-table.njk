{# Primary palettes #}
{%- for group in colorTokens | rejectattr("layout", "equalto", "secondary") -%}
<h3>{{ group.family }}</h3>
{%- if group.description -%}
<p class="color-group-description">{{ group.description }}</p>
{%- endif -%}
<div class="color-token-table-wrap scroll-shadows--horizontal"><table class="color-token-table">
  <thead>
    <tr>
      <th scope="col">Swatch</th>
      <th scope="col">Hex Code</th>
      <th scope="col">Token</th>
      <th scope="col">Use Case(s)</th>
    </tr>
  </thead>
  <tbody>
    {%- for c in group.colors -%}
    <tr>
      <td><span class="color-swatch" style="background-color: {{ c.hex }};" aria-hidden="true"></span></td>
      <td><code>{{ c.hex }}</code><button class="copy-btn" data-copy-value="{{ c.hex }}" aria-label="Copy hex code {{ c.hex }}"></button></td>
      <td>{%- for t in c.token -%}<code>{{ t }}</code>{% if not loop.last %}<br>{% endif %}{%- endfor -%}</td>
      <td>{{ c.useCase }}</td>
    </tr>
    {%- endfor -%}
  </tbody>
</table></div>
{%- endfor -%}

{# Secondary palettes: 3 columns, no Use Case #}
<h2>Secondary color tables</h2>
<p>Our secondary colors are orange, pink, indigo, and green. These should only be used in special cases for things like success, warning, or alert banners, as well as different kinds of accents. They can also be a good option for icons. In all cases, remember to never use color alone to convey meaning.</p>
<div class="color-token-grid">
  {%- for group in colorTokens | selectattr("layout", "equalto", "secondary") -%}
  <div class="color-token-grid-item">
    <h3>{{ group.family }}</h3>
    {%- if group.description -%}
    <p class="color-group-description">{{ group.description }}</p>
    {%- endif -%}
    <div class="color-token-table-wrap scroll-shadows--horizontal"><table class="color-token-table color-token-table--compact">
      <thead>
        <tr>
          <th scope="col">Swatch</th>
          <th scope="col">Hex Code</th>
          <th scope="col">Token</th>
        </tr>
      </thead>
      <tbody>
        {%- for c in group.colors -%}
        <tr>
          <td><span class="color-swatch" style="background-color: {{ c.hex }};" aria-hidden="true"></span></td>
          <td><code>{{ c.hex }}</code><button class="copy-btn" data-copy-value="{{ c.hex }}" aria-label="Copy hex code {{ c.hex }}"></button></td>
          <td>{%- for t in c.token -%}<code>{{ t }}</code>{% if not loop.last %}<br>{% endif %}{%- endfor -%}</td>
        </tr>
        {%- endfor -%}
      </tbody>
    </table></div>
  </div>
  {%- endfor -%}
</div>

<div class="visually-hidden" role="status" aria-live="polite" id="copy-status"></div>
